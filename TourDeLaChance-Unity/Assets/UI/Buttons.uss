/* Les boutons v4 « jeu de plateforme » (spec v4 §5.3 et §5.4), partagés par tous les écrans
   (chaque UXML ajoute <Style src="Buttons.uss" />). Référence 1920 × 1080.

   Anatomie d'un bouton .btn :
   - un CONTOUR de 4 px très foncé sur les côtés et en haut ;
   - une ÉPAISSEUR 3D : la bordure basse de 10 px (couleur « épaisseur ») ;
   - un DÉGRADÉ du « clair » en haut à la « base » en bas : une image de 1 × 32 pixels
     fabriquée par le code (UiFxTextures, rangée dans Degrades/), étirée sur tout le bouton ;
   - un REFLET blanc en haut et une OMBRE portée derrière les gros boutons (classe
     .btn--ombre) : tous deux DESSINÉS par le code (ButtonStyler) ;
   - un texte blanc entouré d'un contour de 3 px de la couleur « contour ».
   États : survol (1,08, petit rebond), appui (0,92, descend de 6 px, épaisseur 10 → 4 px),
   relâché (rebond par 1,12 : classe .btn--rebond posée un court instant par ButtonStyler),
   désactivé (gris, sans reflet, ne réagit pas). */

.btn {
    --contour: #21155E;
    --epaisseur: #4530A8;
    color: #FFFFFF;
    -unity-font-style: bold;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: var(--contour);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    border-radius: 22px;
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 4px;
    border-bottom-width: 10px;
    border-left-color: var(--contour);
    border-right-color: var(--contour);
    border-top-color: var(--contour);
    border-bottom-color: var(--epaisseur);
    background-color: #6C4FE0;
    background-image: url("Degrades/bouton_violet.png");
    -unity-background-scale-mode: stretch-to-fill;
    /* Survol : 0,18 s avec un petit rebond (ease-out-back). */
    transition-property: scale, translate, border-bottom-width, opacity;
    transition-duration: 0.18s, 0.18s, 0.18s, 0.15s;
    transition-timing-function: ease-out-back, ease-out-back, ease-out-back, ease-out;
}

.btn:hover {
    scale: 1.08 1.08;
}

/* Appui : il rétrécit (0,92), descend de 6 px et s'enfonce dans son épaisseur (10 → 4 px). */
.btn:active {
    scale: 0.92 0.92;
    translate: 0 6px;
    border-bottom-width: 4px;
    transition-duration: 0.06s, 0.06s, 0.06s, 0.06s;
    transition-timing-function: ease-out, ease-out, ease-out, ease-out;
}

/* Relâché : un court passage par 1,12, puis retour au survol (1,08) en 0,25 s ease-out-back. */
.btn.btn--rebond {
    scale: 1.12 1.12;
    transition-duration: 0.07s, 0.07s, 0.07s, 0.07s;
    transition-timing-function: ease-out, ease-out, ease-out, ease-out;
}

/* Désactivé : gris, sans dégradé ni reflet ni contour de texte, pas d'agrandissement. */
.btn:disabled {
    --contour: #2A2838;
    --epaisseur: #45425A;
    background-image: none;
    background-color: #6E6A80;
    color: #D0CCE0;
    -unity-text-outline-width: 0;
    opacity: 0.8;
    scale: 1 1;
    translate: 0 0;
    border-bottom-width: 10px;
}

/* Texte d'un bouton qui contient d'autres éléments (« Jouer » et son éclat). */
.btn-label {
    flex-grow: 1;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
    color: #FFFFFF;
    -unity-font-style: bold;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: var(--contour);
}

/* L'éclat qui passe (seulement sur « Jouer ») : une bande blanche inclinée, déplacée par le code. */
.btn-eclat {
    position: absolute;
    top: -20px;
    bottom: -20px;
    width: 40px;
    left: 0;
    background-color: rgba(255, 255, 255, 0.25);
    rotate: 20deg;
}

/* ---------- Les familles de couleurs (§5.4) : base, clair (dégradé), épaisseur, contour ---------- */

/* Vert « sûr » : Encaisser, Ouvrir, Améliorer, Rouvrir, Valider */
.btn--vert { --contour: #0E3D21; --epaisseur: #1E6E3E; background-color: #2E9E5B; background-image: url("Degrades/bouton_vert.png"); }
/* Violet : Rejouer, OK, onglet actif */
.btn--violet { --contour: #21155E; --epaisseur: #4530A8; background-color: #6C4FE0; background-image: url("Degrades/bouton_violet.png"); }
/* Or : Jouer (le seul bouton qui a l'éclat qui passe) */
.btn--or { --contour: #6B4300; --epaisseur: #D99A1A; background-color: #FFC93C; background-image: url("Degrades/bouton_or.png"); }
/* Bleu : Équiper, Actualiser */
.btn--bleu { --contour: #0E2D6B; --epaisseur: #2858A0; background-color: #3B7DD8; background-image: url("Degrades/bouton_bleu.png"); }
/* Rouge : seulement le bouton fermer (×) */
.btn--rouge { --contour: #5E1013; --epaisseur: #B02A30; background-color: #F0484E; background-image: url("Degrades/bouton_rouge.png"); }
/* Sombre : colonnes, onglets inactifs, roue dentée, Vendre */
.btn--sombre { --contour: #110D1F; --epaisseur: #241F3A; background-color: #3A3358; background-image: url("Degrades/bouton_sombre.png"); }

/* Les états désactivés gagnent toujours sur les familles (règle plus précise). */
.btn--vert:disabled, .btn--violet:disabled, .btn--or:disabled, .btn--bleu:disabled,
.btn--rouge:disabled, .btn--sombre:disabled {
    --contour: #2A2838;
    --epaisseur: #45425A;
    background-image: none;
    background-color: #6E6A80;
    color: #D0CCE0;
    -unity-text-outline-width: 0;
}

/* ---------- Boutons ronds (fermer, roue dentée) ---------- */
.btn-rond {
    width: 72px;
    height: 72px;
    border-radius: 36px;
    padding: 0;
    margin: 0;
    align-items: center;
    justify-content: center;
}

/* La croix blanche du bouton fermer : deux barres épaisses dessinées en USS. */
.croix {
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    transition-property: rotate;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-back;
}
.croix-barre {
    position: absolute;
    width: 38px;
    height: 10px;
    border-radius: 5px;
    background-color: #FFFFFF;
    border-width: 2px;
    border-color: #5E1013;
}
.croix-barre--a { rotate: 45deg; }
.croix-barre--b { rotate: -45deg; }
.btn-rond:hover .croix { rotate: 90deg; }

/* L'icône de la roue dentée : elle tourne de 60° au survol. Le dessin a une marge
   transparente : l'image fait 60 px pour que la roue elle-même mesure ~48 px (spec §6.2). */
.roue-icone {
    width: 60px;
    height: 60px;
    background-image: url("../Art/icones_detourees/icone_reglages.png");
    -unity-background-scale-mode: scale-to-fit;
    transition-property: rotate;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-back;
}
.btn-rond:hover .roue-icone { rotate: 60deg; }
