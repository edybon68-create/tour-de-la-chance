/* Style du panneau latéral du shop (spec boites §7.2 à §7.5).
   Les tailles sont pour la résolution de référence 1920 × 1080 (HudPanelSettings) :
   ce sont celles de la spec (écrites pour 1280 × 720) multipliées par 1,5.
   Couleurs : or #FFD54A = argent / sélection, vert #2E9E5B = ouvrir, bleu #3B7DD8 = équiper.
   Les couleurs de RARETÉ ne sont pas ici : le code les lit dans le catalogue (une seule source). */

/* v3 : le cadre et la colonne des panneaux sont dans Panels.uss ; ce fichier garde le
   style du contenu (cartes de boîtes, cartes d'objets, sous-onglets, zone d'action). */

/* --- 2. Porte-monnaie --- */
.shop-wallet-row {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    margin: 8px 4px 6px 0;
    flex-shrink: 0;
}

.shop-wallet {
    font-size: 30px;
    color: #FFD54A;
    -unity-font-style: bold;
    margin-left: 6px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #3A2200;
}

.coin {
    width: 34px;
    height: 34px;
    background-image: url("../Art/icones_detourees/piece.png");
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.coin--small {
    width: 26px;
    height: 26px;
    margin-left: 4px;
}

/* --- 3. Pages --- */
.shop-page {
    flex-grow: 1;
    flex-shrink: 1;
    display: none;
}

.shop-page--active {
    display: flex;
}

.shop-scroll {
    flex-grow: 1;
    flex-shrink: 1;
}

/* Les barres de défilement restent discrètes. */
.shop-scroll .unity-scroller--vertical {
    width: 12px;
}

/* --- Carte de boîte (onglet Boutique) --- */
.box-card {
    background-color: #33334A;
    border-radius: 16px;
    padding: 16px;
    margin-bottom: 16px;
}

.box-top {
    flex-direction: row;
    align-items: center;
}

.box-image {
    width: 180px;
    height: 180px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.box-title-col {
    flex-grow: 1;
    margin-left: 16px;
}

.box-name {
    font-size: 32px;
    color: #FFFFFF;
    -unity-font-style: bold;
    white-space: normal;
}

.price-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.price-text {
    font-size: 30px;
    color: #FFD54A;
    -unity-font-style: bold;
}

/* Progression « Collection : 7 / 16 » et barre fine (or, jamais une couleur de rareté). */
.progress-row {
    margin: 10px 0 8px 0;
    flex-shrink: 0;
}

.progress-text {
    font-size: 22px;
    color: #E6E1EE;
    margin-bottom: 4px;
}

.progress-bar {
    height: 8px;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.4);
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    width: 0;
    background-color: #FFD54A;
    border-radius: 4px;
}

/* Tableau des taux de drop : toujours visible. */
.rates {
    background-color: rgba(0, 0, 0, 0.18);
    border-radius: 10px;
    padding: 6px 10px;
}

.rate-row {
    flex-direction: row;
    align-items: center;
    height: 34px;
}

.rate-row--header {
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
}

.rate-cell {
    font-size: 21px;
    color: #E6E1EE;
    padding: 0;
    margin: 0;
}

.rate-row--header .rate-cell {
    color: #A8A2B8;
    font-size: 18px;
}

.rate-dot-cell {
    width: 34px;
    align-items: center;
    justify-content: center;
}

.rate-dot {
    width: 16px;
    height: 16px;
    border-radius: 8px;
}

.rate-name {
    flex-grow: 1;
    -unity-font-style: bold;
}

.rate-chance {
    width: 120px;
    -unity-text-align: middle-right;
}

.rate-count {
    width: 110px;
    -unity-text-align: middle-right;
}

.rates-note {
    font-size: 18px;
    color: #A8A2B8;
    white-space: normal;
    margin: 6px 2px 10px 2px;
}

.complete-banner {
    font-size: 21px;
    color: #FFD54A;
    background-color: rgba(255, 213, 74, 0.12);
    border-radius: 8px;
    padding: 8px 12px;
    margin-bottom: 10px;
    white-space: normal;
    -unity-font-style: bold;
}

.box-buttons {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

/* « Ouvrir — 250 » : famille verte des boutons bonbons (Buttons.uss). */
.open-btn {
    font-size: 30px;
    height: 76px;
    min-width: 280px;
    margin: 0;
}

.missing {
    font-size: 22px;
    color: #D64545;
    margin-left: 14px;
    -unity-font-style: bold;
}

.link-btn {
    font-size: 22px;
    color: #C9C3D6;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    margin: 8px 0 0 0;
    padding: 4px 6px;
    -unity-font-style: bold;
    align-self: flex-start;
}

.link-btn:hover {
    color: #FFD54A;
}

/* --- Sous-onglets (Inventaire, Index) --- */
.subtabs {
    flex-direction: row;
    margin: 0 0 8px 0;
    flex-shrink: 0;
}

/* Sous-onglets : famille « sombre » ; l'onglet actif est or. */
.subtab {
    font-size: 22px;
    height: 54px;
    flex-grow: 1;
    margin: 0 6px 0 0;
    border-radius: 12px;
}

.subtab--active {
    color: #3A2200;
    background-color: #FFD54A;
    border-top-color: #FFE27A;
    border-bottom-color: #C99A1E;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.subtab--active:hover {
    background-color: #FFE27A;
}

/* --- Grille de cartes d'objets (Inventaire et Index) --- */
.row-title {
    font-size: 24px;
    color: #FFD54A;
    -unity-font-style: bold;
    margin: 6px 0 4px 2px;
}

.grid {
    flex-direction: row;
    flex-wrap: wrap;
}

/* Le cadre extérieur montre la SÉLECTION (contour or épais) ; la carte intérieure
   porte le liseré de RARETÉ (couleur posée par le code). */
.item-frame {
    width: 146px;
    margin: 0 4px 8px 0;
    padding: 0;
    border-radius: 14px;
    border-width: 4px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
}

.item-frame--selected {
    border-color: #FFD54A;
}

.item-card {
    border-radius: 10px;
    border-width: 3px;
    border-color: #5A5A70;
    background-color: #2A2A3A;
    padding: 4px 4px 6px 4px;
    align-items: center;
    min-height: 196px;
}

.item-frame:hover .item-card {
    background-color: #3A3A50;
}

.item-number {
    font-size: 16px;
    color: #A8A2B8;
    align-self: flex-start;
    margin: 0;
    padding: 0 2px;
}

.item-visual {
    width: 96px;
    height: 96px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.item-icon {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

/* Silhouette d'un objet non obtenu : l'icône teintée #15121F à 0,9 d'opacité. */
.item-icon--silhouette {
    -unity-background-image-tint-color: rgba(21, 18, 31, 0.9);
}

/* Secret non obtenu : un grand « ? » rose. */
.item-question {
    font-size: 72px;
    color: #FF4FD8;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.item-swatch {
    width: 70px;
    height: 70px;
    border-radius: 12px;
}

/* « Rien » : un cercle barré dessiné en USS (pas d'image). */
.item-none {
    width: 70px;
    height: 70px;
    border-radius: 35px;
    border-width: 6px;
    border-color: #C9C3D6;
}

.item-none-bar {
    position: absolute;
    width: 6px;
    height: 58px;
    left: 26px;
    top: 0;
    background-color: #C9C3D6;
    rotate: 45deg;
}

.item-name {
    font-size: 18px;
    color: #FFFFFF;
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 2px 0 0 0;
    padding: 0;
    -unity-font-style: bold;
}

.item-rarity {
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.item-extra {
    font-size: 15px;
    color: #C9C3D6;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.item-extra--equipped {
    color: #6FE39A;
    -unity-font-style: bold;
}

/* Badge « ×3 » en haut à droite. */
.item-badge {
    position: absolute;
    top: 4px;
    right: 4px;
    font-size: 17px;
    color: #222222;
    background-color: #E6E1EE;
    border-radius: 9px;
    padding: 0 7px;
    -unity-font-style: bold;
}

/* --- Zone d'action de l'Inventaire --- */
.inv-actions {
    flex-shrink: 0;
    border-top-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    padding-top: 8px;
}

.inv-selected {
    font-size: 22px;
    color: #E6E1EE;
    margin-bottom: 6px;
}

.inv-buttons {
    flex-direction: row;
    margin-bottom: 8px;
}

/* Boutons de la zone d'action (familles bleue et sombre, Buttons.uss). */
.action-btn {
    font-size: 24px;
    height: 64px;
    margin: 0 8px 0 0;
    padding: 0 18px;
}

.action-btn--equip {
    flex-grow: 1;
}

.action-btn--sell {
    flex-grow: 1;
}

.action-btn--sellall {
    margin: 0;
}

/* --- Index --- */
.idx-info-row {
    flex-shrink: 0;
    min-height: 60px;
    border-top-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    padding-top: 6px;
}

.idx-info {
    font-size: 21px;
    color: #E6E1EE;
    white-space: normal;
}
