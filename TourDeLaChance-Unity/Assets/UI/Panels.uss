/* La colonne de boutons et le cadre des 4 panneaux (spec v3 §4.3, §4.4), et les cartes du
   panneau Améliorations (§5.7). Référence 1920 × 1080. Les cartes d'objets et de boîtes
   gardent leur style dans Shop.uss ; les boutons « bonbons » sont dans Buttons.uss. */

.panels-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* ---------- La colonne (bord gauche, à 32 px, de y = 230 px) ---------- */
.panel-column {
    position: absolute;
    left: 32px;
    top: 230px;
    width: 120px;
}

.col-btn {
    width: 120px;
    height: 120px;
    margin: 0 0 16px 0;
    padding: 6px 2px 4px 2px;
    border-radius: 20px;
    align-items: center;
    justify-content: flex-start;
    background-color: rgba(42, 42, 58, 0.9); /* #2A2A3A à 90 % */
    border-left-width: 0;
    border-right-width: 0;
}

.col-btn-icon {
    width: 64px;
    height: 64px;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: scale;
    transition-duration: 0.15s;
}

.col-btn-text {
    font-size: 20px;
    color: #F4EEE6;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 0 2px 0 #15121F;
    padding: 0;
    margin: 2px 0 0 0;
}

/* « Améliorations » en taille 17 pour tenir sur une ligne. */
.col-btn-text--small {
    font-size: 17px;
}

/* Le bouton du panneau ouvert : bordure or de 4 px, fond #3A3A50, icône agrandie à 1,1. */
.btn.col-btn--active {
    background-color: #3A3A50;
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 4px;
    border-bottom-width: 4px;
    border-left-color: #FFD54A;
    border-right-color: #FFD54A;
    border-top-color: #FFD54A;
    border-bottom-color: #FFD54A;
}

.btn.col-btn--active > .col-btn-icon {
    scale: 1.1 1.1;
}

/* Interdit (suspense, transition…) : les boutons restent visibles, opacité 0,4, inertes. */
.btn.col-btn:disabled {
    opacity: 0.4;
    background-color: rgba(42, 42, 58, 0.9);
    border-top-color: #3A3A50;
    border-bottom-color: #15121F;
}

.btn.col-btn:disabled > .col-btn-text {
    color: #F4EEE6;
}

/* ---------- Le cadre commun ---------- */
.panel-frame {
    position: absolute;
    left: 168px;
    top: 176px;
    bottom: 0;
    width: 660px;
    background-color: rgba(42, 42, 58, 0.92);
    border-top-right-radius: 24px;
    border-bottom-right-radius: 24px;
    padding: 14px 18px 14px 18px;
}

.panel-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.panel-header-icon {
    width: 48px;
    height: 48px;
    margin-right: 12px;
    -unity-background-scale-mode: scale-to-fit;
}

.panel-title {
    flex-grow: 1;
    font-size: 40px;
    color: #FFD54A;
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #3A2200;
    padding: 0;
    margin: 0;
}

.panel-close {
    width: 64px;
    height: 64px;
    font-size: 36px;
    margin: 0;
    padding: 0;
}

.panel-wallet-row {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    margin: 6px 4px 2px 0;
    flex-shrink: 0;
}

/* « Ta cagnotte en jeu (X) ne se dépense pas : encaisse-la d'abord. » (si cagnotte > 0) */
.pot-note {
    font-size: 18px;
    color: #B8B4C8;
    white-space: normal;
    -unity-text-align: middle-right;
    margin: 0 4px 6px 0;
    flex-shrink: 0;
}

/* ---------- Panneau Améliorations ---------- */
.up-card {
    background-color: #3A3A50;
    border-radius: 16px;
    padding: 16px;
    margin-bottom: 16px;
}

.up-top {
    flex-direction: row;
    align-items: center;
}

.up-icon {
    width: 96px;
    height: 96px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
    margin-right: 14px;
}

.up-title-col {
    flex-grow: 1;
    flex-shrink: 1;
}

.up-name {
    font-size: 30px;
    color: #FFFFFF;
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
}

.up-desc {
    font-size: 20px;
    color: #B8B4C8;
    white-space: normal;
    padding: 0;
    margin: 2px 0 0 0;
}

.up-level-row {
    flex-direction: row;
    align-items: center;
    margin: 12px 0 8px 0;
}

.up-level {
    font-size: 24px;
    color: #F4EEE6;
    -unity-font-style: bold;
    margin: 0 12px 0 0;
    padding: 0;
}

/* Les 5 pastilles : pleines or = acheté, vides contour #6A6A80. */
.up-dot {
    width: 22px;
    height: 22px;
    border-radius: 11px;
    margin-right: 8px;
    border-width: 3px;
    border-color: #6A6A80;
    background-color: rgba(0, 0, 0, 0);
}

.up-dot--full {
    background-color: #FFD54A;
    border-color: #FFD54A;
}

.up-effect {
    font-size: 22px;
    color: #E6E1EE;
    white-space: normal;
    margin: 2px 0;
    padding: 0;
}

.up-effect--strong {
    color: #FFD54A;
    -unity-font-style: bold;
}

/* Mini-tableau des chances de rareté (Coffres précieux) : Maintenant / Prochain. */
.up-table {
    background-color: rgba(0, 0, 0, 0.18);
    border-radius: 10px;
    padding: 6px 10px;
    margin: 4px 0;
}

.up-row {
    flex-direction: row;
    align-items: center;
    height: 32px;
}

.up-row--header .up-cell {
    color: #A8A2B8;
    font-size: 18px;
}

.up-cell {
    font-size: 21px;
    color: #E6E1EE;
    padding: 0;
    margin: 0;
    width: 140px;
    -unity-text-align: middle-right;
}

.up-cell--name {
    flex-grow: 1;
    -unity-text-align: middle-left;
    -unity-font-style: bold;
}

.up-cell-icon {
    width: 28px;
    height: 28px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.up-buy-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 10px;
}

.up-buy {
    font-size: 30px;
    height: 76px;
    min-width: 300px;
    margin: 0;
}

.up-missing {
    font-size: 22px;
    color: #D64545;
    -unity-font-style: bold;
    margin-left: 14px;
}

.up-max {
    font-size: 26px;
    color: #3A2200;
    background-color: #FFD54A;
    border-radius: 12px;
    padding: 8px 20px;
    -unity-font-style: bold;
}

.up-note {
    font-size: 16px;
    color: #B8B4C8;
    margin-top: 8px;
}
