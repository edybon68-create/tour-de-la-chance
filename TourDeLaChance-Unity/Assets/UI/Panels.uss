/* Le rappel du porte-monnaie et les cartes du panneau Améliorations (spec v3 §5.7, v4 §10.6).
   Référence 1920 × 1080. v4 : le cadre des pop-ups et les colonnes sont dans Popups.uss ; les
   cartes d'objets et de boîtes dans Shop.uss ; les boutons dans Buttons.uss. */

.panels-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* v4 : la colonne, le cadre et l'en-tête sont dans Popups.uss (pop-ups centrées). */

.panel-wallet-row {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    margin: 6px 4px 2px 0;
    flex-shrink: 0;
}

/* « Ta cagnotte en jeu (X) ne se dépense pas : encaisse-la d'abord. » (si cagnotte > 0) */
.pot-note {
    font-size: 18px;
    color: #B8B4C8;
    white-space: normal;
    -unity-text-align: middle-right;
    margin: 0 4px 6px 0;
    flex-shrink: 0;
}

/* ---------- Panneau Améliorations ---------- */
.up-card {
    background-color: #3A3358;
    border-width: 4px;
    border-color: #110D1F;
    border-radius: 22px;
    padding: 16px;
    margin-bottom: 16px;
}

.up-top {
    flex-direction: row;
    align-items: center;
}

.up-icon {
    width: 96px;
    height: 96px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
    margin-right: 14px;
}

.up-title-col {
    flex-grow: 1;
    flex-shrink: 1;
}

.up-name {
    font-size: 30px;
    color: #FFFFFF;
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
}

.up-desc {
    font-size: 20px;
    color: #B8B4C8;
    white-space: normal;
    padding: 0;
    margin: 2px 0 0 0;
}

.up-level-row {
    flex-direction: row;
    align-items: center;
    margin: 12px 0 8px 0;
}

.up-level {
    font-size: 24px;
    color: #F4EEE6;
    -unity-font-style: bold;
    margin: 0 12px 0 0;
    padding: 0;
}

/* Les 10 pastilles (v4 §10.6) : Ø 20 px, 6 px d'écart ; pleines or = acheté. */
.up-dot {
    width: 20px;
    height: 20px;
    border-radius: 10px;
    margin-right: 6px;
    border-width: 3px;
    border-color: #6A6A80;
    background-color: rgba(0, 0, 0, 0);
}

.up-dot--full {
    background-color: #FFD54A;
    border-color: #FFD54A;
}

.up-effect {
    font-size: 22px;
    color: #E6E1EE;
    white-space: normal;
    margin: 2px 0;
    padding: 0;
}

.up-effect--strong {
    color: #FFD54A;
    -unity-font-style: bold;
}

/* Mini-tableau des chances de rareté (Coffres précieux) : Maintenant / Prochain. */
.up-table {
    background-color: rgba(0, 0, 0, 0.18);
    border-radius: 10px;
    padding: 6px 10px;
    margin: 4px 0;
}

.up-row {
    flex-direction: row;
    align-items: center;
    height: 32px;
}

.up-row--header .up-cell {
    color: #A8A2B8;
    font-size: 18px;
}

.up-cell {
    font-size: 21px;
    color: #E6E1EE;
    padding: 0;
    margin: 0;
    width: 140px;
    -unity-text-align: middle-right;
}

.up-cell--name {
    flex-grow: 1;
    -unity-text-align: middle-left;
    -unity-font-style: bold;
}

.up-cell-icon {
    width: 28px;
    height: 28px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.up-buy-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 10px;
}

.up-buy {
    font-size: 30px;
    height: 84px;
    min-width: 300px;
    margin: 0;
}

.up-missing {
    font-size: 22px;
    color: #D64545;
    -unity-font-style: bold;
    margin-left: 14px;
}

.up-max {
    font-size: 30px;
    color: #3A2200;
    background-color: #FFD54A;
    border-width: 4px;
    border-color: #6B4300;
    border-radius: 18px;
    padding: 8px 20px;
    -unity-font-style: bold;
}

.up-note {
    font-size: 16px;
    color: #B8B4C8;
    margin-top: 8px;
}
