/* Style de l'interface. Couleurs : or (#FFD54A) pour l'argent, vert = sûr, rouge = risque. */

.root {
    flex-grow: 1;
    padding: 32px;
}

.top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

/* v3 §9 : lisible sur le ciel clair du jour → contour de 2 px + ombre de texte. */
.floor {
    font-size: 64px;
    color: #FFD54A;
    -unity-font-style: bold;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: #3A2200;
    text-shadow: 0 3px 0 rgba(31, 23, 48, 0.6);
}

.counters {
    align-items: flex-end;
}

/* Un compteur : une "pilule" sombre qui range le texte et la pièce en ligne. */
.counter {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.5);
    padding: 8px 14px 8px 18px;
    border-radius: 12px;
    margin-bottom: 8px;
}

.counter-text {
    font-size: 30px;
    color: #FFFFFF;
    padding: 0;
    margin: 0;
}

/* La petite pièce d'or à côté des montants. Le chemin est relatif à ce fichier .uss.
   "scale-to-fit" garde les proportions de l'image sans la déformer. */
.coin {
    width: 36px;
    height: 36px;
    margin-left: 8px;
    background-image: url("../Art/icones_detourees/piece.png");
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.pot {
    color: #FFD54A;
}

/* La boîte du message (fond sombre) et ses deux lignes. */
.message {
    align-self: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.45);
    padding: 8px 24px;
    border-radius: 14px;
    margin-bottom: 16px;
}

.message-text {
    font-size: 36px;
    color: #FFFFFF;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #000000;
    white-space: normal;
    padding: 0;
    margin: 0;
}

/* 2e ligne (« Cagnotte perdue : X pièces. ») : taille 28. */
.message-sub {
    font-size: 28px;
    color: #E6E1EE;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #000000;
    padding: 0;
    margin: 2px 0 0 0;
}

/* v3 §5.6 : l'étiquette d'étage, une rangée de pastilles juste au-dessus du message. */
.floor-tag {
    flex-direction: row;
    justify-content: center;
    align-self: center;
    margin-bottom: 10px;
}

.floor-pill {
    flex-direction: row;
    align-items: center;
    background-color: rgba(31, 23, 48, 0.75); /* #1F1730 à 75 % */
    border-radius: 14px;
    padding: 4px 16px 4px 10px;
    margin: 0 6px;
}

.floor-pill-icon {
    width: 40px;
    height: 40px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.floor-pill-text {
    font-size: 26px;
    color: #F4EEE6;
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
}

.spacer {
    flex-grow: 1;
}

.actions {
    flex-direction: row;
    justify-content: center;
}

/* Les gros boutons d'action (Encaisser, Rejouer). Leur style « bonbon » est dans Buttons.uss. */
.btn-action, .btn-cashout {
    font-size: 34px;
    min-width: 260px;
    height: 92px;
    margin: 0 16px;
}

/* ---------- Ajouts « game feel » (spec sons-animations) ---------- */

.top-left {
    align-items: flex-start;
}

/* Les deux petits boutons du son, sous « Étage N ». */
.sound-toggles {
    flex-direction: row;
    margin-top: 4px;
}

/* v3 (B4, §10.5) : texte 24 px, hauteur mini 48 px, marge 8 × 16, famille « sombre ». */
.sound-toggle {
    font-size: 24px;
    min-height: 48px;
    padding: 8px 16px;
    margin: 0 8px 0 0;
    border-radius: 14px;
}

/* « … : non » : le bouton passe à moitié transparent. */
.sound-toggle--off {
    opacity: 0.5;
}

/* Le bouton « Encaisser X » : texte + pièce, en ligne. */
.btn-cashout {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 0 24px;
}

.btn-cashout-text {
    font-size: 34px;
    color: #FFFFFF;
    -unity-font-style: bold;
    text-shadow: 0 2px 0 #1E6E3E;
    padding: 0;
    margin: 0;
}

/* Voile plein écran couleur nuit, invisible au repos (le code change son opacité).
   Les marges négatives annulent le padding de .root : il couvre tout l'écran. */
.veil {
    position: absolute;
    left: -32px;
    top: -32px;
    right: -32px;
    bottom: -32px;
    background-color: #1F1730;
    opacity: 0;
}

.fx-layer {
    position: absolute;
    left: -32px;
    top: -32px;
    right: -32px;
    bottom: -32px;
}

/* Le texte flottant « +20 » au-dessus du coffre choisi. */
.float-text {
    position: absolute;
    font-size: 48px;
    color: #FFD54A;
    -unity-font-style: bold;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: #3A2200;
    -unity-text-align: middle-center;
    width: 200px;
    margin-left: -100px;
    margin-top: -30px;
}

/* Une pièce volante (encaissement) : 28 px, même image que .coin. */
.flying-coin {
    position: absolute;
    width: 28px;
    height: 28px;
    margin-left: -14px;
    margin-top: -14px;
    background-image: url("../Art/icones_detourees/piece.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* La bannière « Étage N » au centre de l'écran. */
.banner {
    position: absolute;
    left: -32px;
    top: -32px;
    right: -32px;
    bottom: -32px;
    align-items: center;
    justify-content: center;
    opacity: 0;
}

.banner-floor {
    font-size: 72px;
    color: #FFD54A;
    -unity-font-style: bold;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: #3A2200;
}

/* v3 §9 : fond #1F1730 à 55 % derrière les lignes de la bannière (lisible sur le jour). */
.banner-box {
    align-items: center;
    background-color: rgba(31, 23, 48, 0.55);
    border-radius: 24px;
    padding: 12px 40px 16px 40px;
}

.banner-tier {
    font-size: 32px;
    color: #F4EEE6;
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #1F1730;
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 1100px;
}

/* 3e ligne : « ★ Nouveau record ! ★ » (taille 26, or). */
.banner-record {
    font-size: 26px;
    color: #FFD54A;
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #3A2200;
    margin-top: 4px;
}
