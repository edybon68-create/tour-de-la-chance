/* Style de l'interface. Couleurs : or (#FFD54A) pour l'argent, vert = sûr, rouge = risque. */

.root {
    flex-grow: 1;
    padding: 32px;
}

.top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.counters {
    align-items: flex-end;
}

/* Un compteur : une "pilule" sombre qui range le texte et la pièce en ligne. */
.counter {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.5);
    padding: 8px 14px 8px 18px;
    border-radius: 12px;
    margin-bottom: 8px;
}

.counter-text {
    font-size: 30px;
    color: #FFFFFF;
    padding: 0;
    margin: 0;
}

/* La petite pièce d'or à côté des montants. Le chemin est relatif à ce fichier .uss.
   "scale-to-fit" garde les proportions de l'image sans la déformer. */
.coin {
    width: 36px;
    height: 36px;
    margin-left: 8px;
    background-image: url("../Art/icones_detourees/piece.png");
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.pot {
    color: #FFD54A;
}

/* La boîte du message (fond sombre) et ses deux lignes. */
.message {
    align-self: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.45);
    padding: 8px 24px;
    border-radius: 14px;
    margin-bottom: 16px;
}

.message-text {
    font-size: 36px;
    color: #FFFFFF;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #000000;
    white-space: normal;
    padding: 0;
    margin: 0;
}

/* 2e ligne (« Cagnotte perdue : X pièces. ») : taille 28. */
.message-sub {
    font-size: 28px;
    color: #E6E1EE;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #000000;
    padding: 0;
    margin: 2px 0 0 0;
}

/* v5 §9 : les pastilles v3 (.floor-tag) sont remplacées par la carte d'étage (V5.uss). */

.spacer {
    flex-grow: 1;
}

.actions {
    flex-direction: row;
    justify-content: center;
}

/* Les gros boutons d'action (Encaisser, Rejouer). Leur style « bonbon » est dans Buttons.uss. */
.btn-action, .btn-cashout {
    font-size: 34px;
    min-width: 280px;
    height: 100px;
    margin: 0 16px;
}

/* ---------- Ajouts « game feel » (spec sons-animations) ---------- */


/* Le bouton « Encaisser X » : texte + pièce, en ligne. */
.btn-cashout {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 0 24px;
}

.btn-cashout-text {
    font-size: 34px;
    color: #FFFFFF;
    -unity-font-style: bold;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: #0E3D21;
    padding: 0;
    margin: 0;
}

/* Voile plein écran couleur nuit, invisible au repos (le code change son opacité).
   Les marges négatives annulent le padding de .root : il couvre tout l'écran. */
.veil {
    position: absolute;
    left: -32px;
    top: -32px;
    right: -32px;
    bottom: -32px;
    background-color: #1F1730;
    opacity: 0;
}

.fx-layer {
    position: absolute;
    left: -32px;
    top: -32px;
    right: -32px;
    bottom: -32px;
}

/* Le texte flottant « +20 » au-dessus du coffre choisi. */
.float-text {
    position: absolute;
    font-size: 48px;
    color: #FFD54A;
    -unity-font-style: bold;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: #3A2200;
    -unity-text-align: middle-center;
    width: 200px;
    margin-left: -100px;
    margin-top: -30px;
}

/* Une pièce volante (encaissement) : 28 px, même image que .coin. */
.flying-coin {
    position: absolute;
    width: 28px;
    height: 28px;
    margin-left: -14px;
    margin-top: -14px;
    background-image: url("../Art/icones_detourees/piece.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* La bannière « Étage N » au centre de l'écran. */
.banner {
    position: absolute;
    left: -32px;
    top: -32px;
    right: -32px;
    bottom: -32px;
    align-items: center;
    justify-content: center;
    opacity: 0;
}

.banner-floor {
    font-size: 72px;
    color: #FFD54A;
    -unity-font-style: bold;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: #3A2200;
}

/* v3 §9 : fond #1F1730 à 55 % derrière les lignes de la bannière (lisible sur le jour). */
.banner-box {
    align-items: center;
    background-color: rgba(31, 23, 48, 0.55);
    border-radius: 24px;
    padding: 12px 40px 16px 40px;
}

.banner-tier {
    font-size: 32px;
    color: #F4EEE6;
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #1F1730;
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 1100px;
}

/* 3e ligne : « ★ Nouveau record ! ★ » (taille 26, or). */
.banner-record {
    font-size: 26px;
    color: #FFD54A;
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #3A2200;
    margin-top: 4px;
}

/* ---------- v4 §6.1 : le badge d'étage ---------- */
/* La racine du HUD a 32 px de marge : le badge est donc à 32 px du bord gauche ; on le
   remonte de 8 px pour qu'il soit à 24 px du haut. */
.badge-holder {
    margin-top: -8px;
}

.badge {
    width: 200px;
    height: 116px;
    align-items: center;
    justify-content: center;
    border-radius: 28px;
    border-left-width: 5px;
    border-right-width: 5px;
    border-top-width: 5px;
    border-bottom-width: 8px;          /* l'épaisseur 3D */
    border-left-color: #110D1F;
    border-right-color: #110D1F;
    border-top-color: #110D1F;
    border-bottom-color: #110D1F;
    -unity-background-scale-mode: stretch-to-fill;
}
/* Le fond suit le palier de décor (dégradé fabriqué par le code, UiFxTextures). */
.badge--palier1 { background-color: #3B7DD8; background-image: url("Degrades/badge_palier1.png"); }
.badge--palier2 { background-color: #E0705A; background-image: url("Degrades/badge_palier2.png"); }
.badge--palier3 { background-color: #6C4FE0; background-image: url("Degrades/badge_palier3.png"); }
.badge--palier4 { background-color: #2E2366; background-image: url("Degrades/badge_palier4.png"); }
/* Record battu : contour or. */
.badge--record {
    border-left-color: #FFD54A;
    border-right-color: #FFD54A;
    border-top-color: #FFD54A;
}

.badge-word {
    font-size: 22px;
    color: #FFD54A;
    -unity-font-style: bold;
    letter-spacing: 3px;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: #110D1F;
    margin: 0 0 -8px 0;
    padding: 0;
}
.badge-number {
    font-size: 64px;
    color: #FFFFFF;
    -unity-font-style: bold;
    -unity-text-outline-width: 5px;
    -unity-text-outline-color: #110D1F;
    text-shadow: 0 4px 0 rgba(17, 13, 31, 0.8);
    margin: 0;
    padding: 0;
}
.badge-number--long { font-size: 52px; }

/* L'étiquette « RECORD » posée en travers du coin bas droit. */
.badge-record {
    position: absolute;
    right: -22px;
    bottom: -14px;
    font-size: 16px;
    color: #6B4300;
    -unity-font-style: bold;
    background-color: #FFD54A;
    border-width: 3px;
    border-color: #6B4300;
    border-radius: 10px;
    padding: 2px 8px;
    rotate: -12deg;
    display: none;
}
.badge--record .badge-record { display: flex; }

/* Palier 4 : 5 petites étoiles qui scintillent (créées et animées par le code). */
.badge-stars {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    display: none;
}
.badge--palier4 .badge-stars { display: flex; }
.badge-star {
    position: absolute;
    width: 10px;
    height: 10px;
    -unity-background-image-tint-color: #FFF1D6;
}
