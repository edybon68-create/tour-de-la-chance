/* Style de l'interface. Couleurs : or (#FFD54A) pour l'argent, vert = sûr, rouge = risque. */

.root {
    flex-grow: 1;
    padding: 32px;
}

.top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.floor {
    font-size: 64px;
    color: #FFD54A;
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #3A2200;
}

.counters {
    align-items: flex-end;
}

/* Un compteur : une "pilule" sombre qui range le texte et la pièce en ligne. */
.counter {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.5);
    padding: 8px 14px 8px 18px;
    border-radius: 12px;
    margin-bottom: 8px;
}

.counter-text {
    font-size: 30px;
    color: #FFFFFF;
    padding: 0;
    margin: 0;
}

/* La petite pièce d'or à côté des montants. Le chemin est relatif à ce fichier .uss.
   "scale-to-fit" garde les proportions de l'image sans la déformer. */
.coin {
    width: 36px;
    height: 36px;
    margin-left: 8px;
    background-image: url("../Art/icones_detourees/piece.png");
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.pot {
    color: #FFD54A;
}

.message {
    font-size: 36px;
    color: #FFFFFF;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #000000;
    white-space: normal;
    align-self: center;
    background-color: rgba(0, 0, 0, 0.45);
    padding: 8px 24px;
    border-radius: 14px;
    margin-bottom: 16px;
}

.spacer {
    flex-grow: 1;
}

.actions {
    flex-direction: row;
    justify-content: center;
}

.btn {
    font-size: 34px;
    min-width: 260px;
    height: 84px;
    margin: 0 16px;
    border-radius: 16px;
    border-width: 0;
    color: #FFFFFF;
    background-color: #5B5BD6;
    -unity-font-style: bold;
    /* Survol : échelle 1,05 en 0,08 s ; appui : 0,95 (§3.10). */
    transition-property: scale;
    transition-duration: 0.08s;
}

.btn:hover {
    scale: 1.05 1.05;
}

.btn:active {
    scale: 0.95 0.95;
}

.btn-safe {
    background-color: #2E9E5B;
}

/* Bouton Boutique : couleur or, pour l'associer aux pièces. */
.btn-shop {
    background-color: #C99A1E;
}

/* ---------- Ajouts « game feel » (spec sons-animations) ---------- */

.top-left {
    align-items: flex-start;
}

/* Les deux petits boutons du son, sous « Étage N ». */
.sound-toggles {
    flex-direction: row;
    margin-top: 4px;
}

.sound-toggle {
    font-size: 16px;
    color: #FFFFFF;
    background-color: rgba(42, 42, 58, 0.8); /* #2A2A3A à 80 % */
    border-width: 0;
    border-radius: 8px;
    padding: 4px 10px;
    margin: 0 8px 0 0;
    transition-property: scale;
    transition-duration: 0.08s;
}

.sound-toggle:hover {
    scale: 1.05 1.05;
}

.sound-toggle:active {
    scale: 0.95 0.95;
}

/* « … : non » : le bouton passe à moitié transparent. */
.sound-toggle--off {
    opacity: 0.5;
}

/* Le bouton « Encaisser X » : texte + pièce, en ligne. */
.btn-cashout {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 0 24px;
}

.btn-cashout-text {
    font-size: 34px;
    color: #FFFFFF;
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
}

/* Voile plein écran couleur nuit, invisible au repos (le code change son opacité).
   Les marges négatives annulent le padding de .root : il couvre tout l'écran. */
.veil {
    position: absolute;
    left: -32px;
    top: -32px;
    right: -32px;
    bottom: -32px;
    background-color: #1F1730;
    opacity: 0;
}

.fx-layer {
    position: absolute;
    left: -32px;
    top: -32px;
    right: -32px;
    bottom: -32px;
}

/* Le texte flottant « +20 » au-dessus du coffre choisi. */
.float-text {
    position: absolute;
    font-size: 48px;
    color: #FFD54A;
    -unity-font-style: bold;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: #3A2200;
    -unity-text-align: middle-center;
    width: 200px;
    margin-left: -100px;
    margin-top: -30px;
}

/* Une pièce volante (encaissement) : 28 px, même image que .coin. */
.flying-coin {
    position: absolute;
    width: 28px;
    height: 28px;
    margin-left: -14px;
    margin-top: -14px;
    background-image: url("../Art/icones_detourees/piece.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* La bannière « Étage N » au centre de l'écran. */
.banner {
    position: absolute;
    left: -32px;
    top: -32px;
    right: -32px;
    bottom: -32px;
    align-items: center;
    justify-content: center;
    opacity: 0;
}

.banner-floor {
    font-size: 72px;
    color: #FFD54A;
    -unity-font-style: bold;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: #3A2200;
}

.banner-tier {
    font-size: 32px;
    color: #F4EEE6;
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #1F1730;
}
