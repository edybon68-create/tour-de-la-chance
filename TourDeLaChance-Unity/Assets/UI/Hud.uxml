<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- La structure de l'interface (comme du HTML). Le style est dans Hud.uss (comme du CSS). -->
    <Style src="Hud.uss" />
    <ui:VisualElement name="root" class="root" picking-mode="Ignore">
        <!-- Le voile sombre des transitions d'étage (§3.11). Il est en premier : il passe
             devant la scène 3D mais derrière le reste de l'interface. -->
        <ui:VisualElement name="veil" class="veil" picking-mode="Ignore" />
        <ui:VisualElement class="top-bar" picking-mode="Ignore">
            <ui:VisualElement class="top-left" picking-mode="Ignore">
                <ui:Label name="floor" text="Étage 1" class="floor" picking-mode="Ignore" />
                <!-- Les deux boutons du son, sous « Étage N » (§6.2). -->
                <ui:VisualElement class="sound-toggles" picking-mode="Ignore">
                    <ui:Button name="music-toggle" text="Musique : oui" class="sound-toggle" />
                    <ui:Button name="effects-toggle" text="Effets : oui" class="sound-toggle" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="counters" picking-mode="Ignore">
                <!-- Chaque compteur = un texte + une petite pièce d'or (image dans Hud.uss). -->
                <ui:VisualElement name="pot-counter" class="counter" picking-mode="Ignore">
                    <ui:Label name="pot" text="Cagnotte : 0" class="counter-text pot" picking-mode="Ignore" />
                    <ui:VisualElement name="pot-coin" class="coin" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="wallet-counter" class="counter" picking-mode="Ignore">
                    <ui:Label name="wallet" text="Porte-monnaie : 0" class="counter-text" picking-mode="Ignore" />
                    <ui:VisualElement name="wallet-coin" class="coin" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="spacer" picking-mode="Ignore" />
        <!-- Le message est en bas, au-dessus des boutons, pour ne jamais cacher le chapeau. -->
        <ui:Label name="message" text="" class="message" picking-mode="Ignore" />
        <ui:VisualElement class="actions" picking-mode="Ignore">
            <!-- « Encaisser X » : proposé pendant le choix d'un coffre, à partir de l'étage 2. -->
            <ui:Button name="cashout" class="btn btn-safe btn-cashout">
                <ui:Label name="cashout-text" text="Encaisser 0" class="btn-cashout-text" picking-mode="Ignore" />
                <ui:VisualElement class="coin" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="replay" text="Rejouer" class="btn" />
            <!-- Ouvre le shop. Visible seulement quand le GameManager le permet. -->
            <ui:Button name="shop" text="Boutique" class="btn btn-shop" />
        </ui:VisualElement>
        <!-- Calque des effets : textes « +20 » et pièces volantes (créés par le code). -->
        <ui:VisualElement name="fx-layer" class="fx-layer" picking-mode="Ignore" />
        <!-- La bannière « Étage N » de la montée, et le nom du palier s'il change. -->
        <ui:VisualElement name="banner" class="banner" picking-mode="Ignore">
            <ui:Label name="banner-floor" text="Étage 2" class="banner-floor" picking-mode="Ignore" />
            <ui:Label name="banner-tier" text="" class="banner-tier" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
