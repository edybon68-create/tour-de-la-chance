<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- L'écran titre, affiché par-dessus tout au lancement. Style : Title.uss.
         Le fond uni a la même couleur que le fond du logo (#1E1936) : on ne voit pas
         les bords de l'image. Le bouton « Jouer » est branché par TitleController. v4 : plus de boutons du son ici,
         la roue dentée des Réglages est dans Panels.uxml (au-dessus de tout). -->
    <Style src="Title.uss" />
    <Style src="Buttons.uss" />
    <ui:VisualElement name="title-root" class="title-root">
        <ui:VisualElement name="logo" class="title-logo" picking-mode="Ignore" />
        <!-- L'enveloppe "play-wrap" respire (échelle animée par le code) ; le bouton
             à l'intérieur garde son effet de survol du USS. -->
        <ui:VisualElement name="play-wrap" class="title-play-wrap" picking-mode="Ignore">
            <ui:Button name="play" text="Jouer" class="btn btn--or btn--ombre title-play" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
